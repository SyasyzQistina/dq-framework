<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Data Quality Report — {{ profile.dataset_name }}</title>
<style>
  body { font-family: system-ui, sans-serif; font-size:14px; color:#222; background:#fff; margin:0; }
  header { background:#1D9E75; color:#fff; padding:2rem; }
  header h1 { font-size:1.6rem; margin:0; }
  header p { margin:.4rem 0 0; opacity:.85; }
  main { max-width:1100px; margin:2rem auto; padding:0 1.5rem; }
  h2 { font-size:1.1rem; border-bottom:2px solid #1D9E75; padding-bottom:.4rem; margin:2rem 0 1rem; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem; }
  .card { background:#f5f5f3; border-radius:10px; padding:1.2rem; text-align:center; }
  .card .value { font-size:2rem; font-weight:700; color:#1D9E75; }
  .card .value.warn  { color:#EF9F27; }
  .card .value.alert { color:#E24B4A; }
  .card .label { font-size:.8rem; color:#666; margin-top:.2rem; }
  .charts-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:1rem; }
  .chart-card { background:#fff; border:1px solid #eee; border-radius:10px;
                padding:.8rem; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
  .chart-card img { width:100%; border-radius:6px; display:block; }
  .chart-card.solo { grid-column:1/-1; max-width:420px; justify-self:center; }
  @media(max-width:700px) { .charts-grid { grid-template-columns:1fr; } }
  .search-wrap { margin-bottom:.8rem; display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; }
  .search-wrap input[type=text] { flex:1; min-width:180px; padding:.45rem .8rem;
    border:1px solid #ddd; border-radius:8px; font-size:.88rem; outline:none; }
  .search-wrap input[type=text]:focus { border-color:#1D9E75; }
  .search-wrap label { font-size:.85rem; color:#666; display:flex;
                       align-items:center; gap:.3rem; cursor:pointer; white-space:nowrap; }
  .search-wrap input[type=checkbox] { width:14px; height:14px; cursor:pointer; }
  #row-count { font-size:.8rem; color:#aaa; }
  table { width:100%; border-collapse:collapse; font-size:.85rem; margin-top:.5rem; }
  th { background:#1D9E75; color:#fff; padding:.5rem .8rem; text-align:left; }
  td { padding:.45rem .8rem; border-bottom:1px solid #eee; }
  tr:nth-child(even) td { background:#f5f5f3; }
  tr:hover td { background:#f0fdf8; }
  tr.hidden { display:none; }
  .high   { color:#E24B4A; font-weight:600; }
  .medium { color:#EF9F27; font-weight:600; }
  .good   { color:#1D9E75; font-weight:600; }
  .badge { display:inline-block; padding:.15rem .5rem; border-radius:999px;
           font-size:.75rem; font-weight:600; color:#fff; margin:.1rem; }
  .badge-high   { background:#E24B4A; }
  .badge-medium { background:#EF9F27; }
  .badge-low    { background:#1D9E75; }
  .issue-block  { background:#fafaf8; border-radius:0 8px 8px 0;
                  padding:.65rem .9rem; margin-bottom:.45rem; }
  .issue-desc   { color:#555; font-size:.86rem; margin-top:.25rem; }
  .issue-action { font-size:.83rem; color:#888; font-style:italic; margin-top:.15rem; }
  footer { text-align:center; color:#999; font-size:.8rem; padding:2rem; }
</style>
</head>
<body>

<header style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
  <div>
    <h1>Data Quality Report: {{ profile.dataset_name }}</h1>
    <p>{{ profile.run_timestamp.strftime('%Y-%m-%d %H:%M') }}
       &nbsp;·&nbsp; {{ "{:,}".format(profile.n_rows) }} rows
       &nbsp;·&nbsp; {{ profile.n_cols }} columns
       &nbsp;·&nbsp; Overall score:
       <strong>{{ "%.1f%%" | format(profile.overall_score * 100) }}</strong>
    </p>
  </div>
  <a href="/download/{{ profile.dataset_name }}"
     style="background:#fff; color:#1D9E75; padding:.7rem 1.5rem;
            border-radius:8px; font-weight:600; text-decoration:none;
            font-size:.9rem; white-space:nowrap;">
     ⬇ Download Report
  </a>
</header>

<main>

  <h2>Summary</h2>
  <div class="cards">
    <div class="card">
      <div class="value {% if profile.overall_score < 0.8 %}alert{% elif profile.overall_score < 0.9 %}warn{% endif %}">
        {{ "%.0f%%" | format(profile.overall_score * 100) }}</div>
      <div class="label">Overall score</div>
    </div>
    {% for dim, score in profile.dimension_scores.items() %}
    <div class="card">
      <div class="value {% if score < 0.8 %}alert{% elif score < 0.9 %}warn{% endif %}">
        {{ "%.0f%%" | format(score * 100) }}</div>
      <div class="label">{{ dim | capitalize }}</div>
    </div>
    {% endfor %}
    <div class="card">
      <div class="value {% if profile.all_issues|length > 10 %}alert{% elif profile.all_issues|length > 3 %}warn{% endif %}">
        {{ profile.all_issues | length }}</div>
      <div class="label">Total issues</div>
    </div>
  </div>
  <p style="margin-top:1rem; color:#555; line-height:1.6;">{{ profile.summary_text }}</p>

  {% if profile.generated_charts %}
  <h2>Visualisations</h2>
  <div class="charts-grid">
    {% for chart in profile.generated_charts %}
    <div class="chart-card {% if loop.last and (profile.generated_charts|length % 3 == 1) %}solo{% endif %}">
      <img src="{{ chart }}" alt="Quality chart {{ loop.index }}"/>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Column Profiles</h2>
  <div class="search-wrap">
    <input type="text" id="col-search" placeholder="🔍  Search column name..."
           oninput="filterTable()"/>
    <label>
      <input type="checkbox" id="issues-only" onchange="filterTable()"/>
      Show issues only
    </label>
    <span id="row-count"></span>
  </div>

  <table id="col-table">
    <thead>
      <tr>
        <th>Column</th><th>Type</th><th>Missing %</th>
        <th>Completeness</th><th>Uniqueness</th>
        <th>Validity</th><th>Consistency</th>
        <th>Score</th><th>Issues</th>
      </tr>
    </thead>
    <tbody id="col-tbody">
    {% for col in profile.columns %}
      <tr data-name="{{ col.col_name | lower }}"
          data-has-issues="{{ '1' if col.issues else '0' }}">
        <td><strong>{{ col.col_name }}</strong></td>
        <td>{{ col.inferred_type }}</td>
        <td>{{ "%.1f" | format(col.pct_missing) }}%</td>
        <td class="{{ 'high' if col.completeness < 0.8 else 'medium' if col.completeness < 0.95 else 'good' }}">{{ "%.2f" | format(col.completeness) }}</td>
        <td class="{{ 'high' if col.uniqueness < 0.7 else 'medium' if col.uniqueness < 0.9 else 'good' }}">{{ "%.2f" | format(col.uniqueness) }}</td>
        <td class="{{ 'high' if col.validity < 0.8 else 'medium' if col.validity < 0.95 else 'good' }}">{{ "%.2f" | format(col.validity) }}</td>
        <td class="{{ 'high' if col.consistency < 0.8 else 'medium' if col.consistency < 0.95 else 'good' }}">{{ "%.2f" | format(col.consistency) }}</td>
        <td class="{{ 'high' if col.overall_score < 0.8 else 'medium' if col.overall_score < 0.9 else 'good' }}">
          <strong>{{ "%.2f" | format(col.overall_score) }}</strong></td>
        <td>
          {% for issue in col.issues %}
          <span class="badge badge-{{ issue.severity }}">{{ issue.issue_type }}</span>
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if profile.all_issues %}
  <h2>Issues Detail</h2>
  <p style="color:#888;font-size:.85rem;margin-bottom:1rem;">
    Showing high and medium severity issues only.
  </p>
  {% for col in profile.columns %}
    {% set serious = col.issues | selectattr('severity', 'in', ['high', 'medium']) | list %}
    {% if serious %}
    <div style="margin-bottom:1.1rem;">
      <div style="font-weight:600;margin-bottom:.4rem;">
        {{ col.col_name }}
        <span style="font-weight:400;color:#aaa;font-size:.82rem;">
          — {{ serious|length }} issue{{ 's' if serious|length > 1 }}
        </span>
      </div>
      {% for issue in serious %}
      <div class="issue-block" style="border-left:3px solid {{ '#E24B4A' if issue.severity == 'high' else '#EF9F27' }};">
        <span class="badge badge-{{ issue.severity }}">{{ issue.severity }}</span>
        <strong style="margin-left:.35rem;">{{ issue.issue_type }}</strong>
        <span style="color:#888;font-size:.82rem;">
          — {{ issue.affected_rows }} rows ({{ issue.pct_affected }}%)
        </span>
        <p class="issue-desc">{{ issue.description }}</p>
        <p class="issue-action">Action: {{ issue.suggested_action }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  {% endfor %}
  {% endif %}

</main>

<footer>Generated by DQ Framework &nbsp;·&nbsp; University of Leeds MSc Project 2026</footer>

<script>
  function filterTable() {
    const search     = document.getElementById('col-search').value.toLowerCase();
    const issuesOnly = document.getElementById('issues-only').checked;
    const rows       = document.querySelectorAll('#col-tbody tr');
    let visible      = 0;

    rows.forEach(row => {
      const name      = row.getAttribute('data-name') || '';
      const hasIssues = row.getAttribute('data-has-issues') === '1';
      const matchName  = name.includes(search);
      const matchIssue = !issuesOnly || hasIssues;

      if (matchName && matchIssue) {
        row.classList.remove('hidden');
        visible++;
      } else {
        row.classList.add('hidden');
      }
    });

    document.getElementById('row-count').textContent =
      visible + ' of ' + rows.length + ' columns';
  }

  filterTable();
</script>
</body>
</html>