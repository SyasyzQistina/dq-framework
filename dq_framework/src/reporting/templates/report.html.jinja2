<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>Data Quality Report — {{ profile.dataset_name }}</title>
<style>
  body { font-family: system-ui, sans-serif; font-size:14px; color:#222; background:#fff; margin:0; }
  header { background:#1D9E75; color:#fff; padding:2rem; }
  header h1 { font-size:1.6rem; margin:0; }
  header p { margin:.4rem 0 0; opacity:.85; }
  main { max-width:1100px; margin:2rem auto; padding:0 1.5rem; }
  h2 { font-size:1.1rem; border-bottom:2px solid #1D9E75; padding-bottom:.4rem; margin:2rem 0 1rem; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem; }
  .card { background:#f5f5f3; border-radius:10px; padding:1.2rem; text-align:center; }
  .card .value { font-size:2rem; font-weight:700; color:#1D9E75; }
  .card .label { font-size:.8rem; color:#666; margin-top:.2rem; }
  .charts { display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:1.5rem; }
  .charts img { width:100%; border-radius:8px; border:1px solid #eee; }
  table { width:100%; border-collapse:collapse; font-size:.85rem; margin-top:1rem; }
  th { background:#1D9E75; color:#fff; padding:.5rem .8rem; text-align:left; }
  td { padding:.45rem .8rem; border-bottom:1px solid #eee; }
  tr:nth-child(even) td { background:#f5f5f3; }
  .high   { color:#E24B4A; font-weight:600; }
  .medium { color:#EF9F27; font-weight:600; }
  .good   { color:#1D9E75; font-weight:600; }
  .badge { display:inline-block; padding:.15rem .5rem; border-radius:999px;
           font-size:.75rem; font-weight:600; color:#fff; margin:.1rem; }
  .badge-high   { background:#E24B4A; }
  .badge-medium { background:#EF9F27; }
  .badge-low    { background:#1D9E75; }
  footer { text-align:center; color:#999; font-size:.8rem; padding:2rem; }
</style>
</head>
<body>
<header style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
  <div>
    <h1>Data Quality Report: {{ profile.dataset_name }}</h1>
    <p>{{ profile.run_timestamp.strftime('%Y-%m-%d %H:%M') }}
       · {{ "{:,}".format(profile.n_rows) }} rows
       · {{ profile.n_cols }} columns
       · Overall score: <strong>{{ "%.1f%%" | format(profile.overall_score * 100) }}</strong>
    </p>
  </div>
  <a href="/download/{{ profile.dataset_name }}"
     style="background:#fff; color:#1D9E75; padding:.7rem 1.5rem;
            border-radius:8px; font-weight:600; text-decoration:none;
            font-size:.9rem; white-space:nowrap;">
     ⬇ Download Report
  </a>
</header>
<main>

  <h2>Summary</h2>
  <div class="cards">
    <div class="card">
      <div class="value">{{ "%.0f%%" | format(profile.overall_score * 100) }}</div>
      <div class="label">Overall score</div>
    </div>
    {% for dim, score in profile.dimension_scores.items() %}
    <div class="card">
      <div class="value">{{ "%.0f%%" | format(score * 100) }}</div>
      <div class="label">{{ dim | capitalize }}</div>
    </div>
    {% endfor %}
    <div class="card">
      <div class="value">{{ profile.all_issues | length }}</div>
      <div class="label">Total issues</div>
    </div>
  </div>
  <p style="margin-top:1rem; color:#555;">{{ profile.summary_text }}</p>

  {% if profile.generated_charts %}
  <h2>Visualisations</h2>
  <div class="charts">
    {% for chart in profile.generated_charts %}
    <img src="{{ chart }}" alt="Quality chart"/>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Column profiles</h2>
  <table>
    <thead>
      <tr>
        <th>Column</th><th>Type</th><th>Missing %</th>
        <th>Completeness</th><th>Uniqueness</th>
        <th>Validity</th><th>Consistency</th>
        <th>Score</th><th>Issues</th>
      </tr>
    </thead>
    <tbody>
    {% for col in profile.columns %}
      <tr>
        <td><strong>{{ col.col_name }}</strong></td>
        <td>{{ col.inferred_type }}</td>
        <td>{{ "%.1f" | format(col.pct_missing) }}%</td>
        <td class="{{ 'high' if col.completeness < 0.8 else 'medium' if col.completeness < 0.95 else 'good' }}">{{ "%.2f" | format(col.completeness) }}</td>
        <td class="{{ 'high' if col.uniqueness < 0.7 else 'medium' if col.uniqueness < 0.9 else 'good' }}">{{ "%.2f" | format(col.uniqueness) }}</td>
        <td class="{{ 'high' if col.validity < 0.8 else 'medium' if col.validity < 0.95 else 'good' }}">{{ "%.2f" | format(col.validity) }}</td>
        <td class="{{ 'high' if col.consistency < 0.8 else 'medium' if col.consistency < 0.95 else 'good' }}">{{ "%.2f" | format(col.consistency) }}</td>
        <td class="{{ 'high' if col.overall_score < 0.8 else 'medium' if col.overall_score < 0.9 else 'good' }}"><strong>{{ "%.2f" | format(col.overall_score) }}</strong></td>
        <td>
          {% for issue in col.issues %}
          <span class="badge badge-{{ issue.severity }}">{{ issue.issue_type }}</span>
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

</main>
<footer>Generated by DQ Framework · University of Leeds MSc Project 2026</footer>
</body>
</html>